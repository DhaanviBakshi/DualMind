# DUALMIND Backend Environment Configuration
# PostgreSQL Database Connection URL (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dualmind?schema=public"

# Auth Secret for JWT signing & session verification (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-secure-random-auth-secret-key-min-32-chars"

# System 2 AI Engine Integration Provider ("gemini", "openai", "groq", "anthropic", or "mock")
AI_PROVIDER="gemini"

# API Key for the chosen AI Provider
AI_API_KEY="your-ai-provider-api-key"

# Optional settings
PORT=3000
NODE_ENV="development"
